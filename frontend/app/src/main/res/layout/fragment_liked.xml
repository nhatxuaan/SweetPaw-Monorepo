<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/header_yeuthich"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:background="@color/pinkDark">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YÊU THÍCH"
            android:textColor="@color/white"
            android:fontFamily="@font/bevietnambold"
            android:textSize="22sp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="25dp"/>
    </RelativeLayout>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="824dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="80dp"
        android:background="@drawable/rectangle_cart" />
<!--    Dùng lại item_product.xml nha-->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerLiked"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_yeuthich"
        android:layout_marginTop="10dp"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        android:overScrollMode="never" />

</RelativeLayout>