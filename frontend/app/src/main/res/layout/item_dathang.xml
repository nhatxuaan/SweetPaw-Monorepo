<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:background="@drawable/dathang_card"
    android:padding="8dp">

    <!-- Ảnh sản phẩm -->
    <androidx.cardview.widget.CardView
        android:layout_width="100dp"
        android:layout_height="94dp"
        android:layout_marginHorizontal="8dp"
        android:layout_gravity="center_vertical"
        app:cardCornerRadius="15dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/imgProduct"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />
    </androidx.cardview.widget.CardView>

    <!-- Thông tin -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bánh kem dâu tây tươi #2"
            android:textStyle="bold"
            android:textColor="#000"
            android:textSize="14sp"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="10dp"/>

        <TextView
            android:id="@+id/tvDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kem dâu tươi trang trí trái dâu thật"
            android:textSize="11sp"
            android:textColor="@color/black"
            android:textStyle="italic"
            android:fontFamily="@font/bevietnammedium"
            android:layout_marginTop="4dp"
            android:layout_marginLeft="10dp"/>

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="360,000đ"
            android:textColor="@color/pinkDark"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="4dp"
            android:layout_marginLeft="10dp"/>

        <!-- Số lượng -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginLeft="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Số lượng: "
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvQuantity"
                android:text="1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:textSize="14sp"
                android:textStyle="bold"/>

        </LinearLayout>


    </LinearLayout>



</LinearLayout>
