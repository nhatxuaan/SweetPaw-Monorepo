<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.fragment.CartFragment">
    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@color/pinkDark"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GIỎ HÀNG"
            android:textColor="@color/white"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="35dp"
            android:textSize="22sp"
            android:textStyle="bold"/>

    </RelativeLayout>

    <ImageView
        android:id="@+id/imgNen"
        android:layout_width="wrap_content"
        android:layout_height="824dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="80dp"
        android:background="@drawable/rectangle_cart" />
    <RelativeLayout
        android:id="@+id/layOutTrong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone">
        <ImageView
            android:id="@+id/logo"
            android:layout_width="118dp"
            android:layout_height="142dp"
            android:src="@drawable/logo"
            android:layout_centerInParent="true"/>
        <TextView
            android:id="@+id/text1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Giỏ hàng hiện đang trống."
            android:gravity="center"
            android:layout_below="@id/logo"
            android:layout_marginTop="90dp"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hãy chọn sản phẩm bạn yêu thích và đặt hàng ngay nào!"
            android:layout_below="@id/text1"
            android:layout_centerHorizontal="true"/>

    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/option"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/header"
        android:paddingBottom="5dp">
        <TextView
            android:id="@+id/tvXoa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xóa"
            android:layout_alignParentLeft="true"
            android:layout_marginLeft="20dp"
            android:textColor="@color/pinkDark"
            android:textSize="12sp"
            android:fontFamily="@font/bevietnammedium"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvChonTB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chọn toàn bộ giỏ hàng"
            android:layout_alignParentRight="true"
            android:layout_marginRight="20dp"
            android:layout_gravity="right"
            android:textColor="@color/pinkDark"
            android:textSize="12sp"
            android:fontFamily="@font/bevietnammedium"/>

    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/option">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="75dp">


            <!-- Danh sách sản phẩm -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvCart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="8dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true"/>

        </RelativeLayout>


    </androidx.core.widget.NestedScrollView>
    <!--    Đặt hàng và gợi ý-->
    <LinearLayout
        android:id="@+id/layOut"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginBottom="20dp"
        android:layout_marginLeft="15sp"
        android:layout_marginRight="15dp"
        android:layout_marginTop="20dp"
        android:visibility="gone">
        <!-- Thanh tổng tiền và đặt hàng -->
        <LinearLayout
            android:id="@+id/layOutTT"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="2"
            android:background="@drawable/border_order"
            android:backgroundTint="@color/pinkDark"
            android:elevation="1dp"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginRight="10dp"
            android:visibility="visible">

            <TextView
                android:id="@+id/tvTongTien"
                android:text="0đ"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"/>

            <TextView
                android:id="@+id/tvDatHang"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Đặt hàng"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_gravity="center"/>
        </LinearLayout>
        <!--   Gợi ý -->
        <LinearLayout
            android:id="@+id/layOutGY"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="0.7"
            android:background="@drawable/border_order"
            android:backgroundTint="@color/pinkDark"
            android:elevation="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvGoiY"
                android:text="Gợi ý"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="18sp"
                android:padding="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:gravity="center_horizontal"
                android:elevation="1dp"/>
        </LinearLayout>

    </LinearLayout>

<!--    android:layout_alignParentEnd="true"-->
<!--    android:layout_alignParentBottom="true"-->
<!--    android:layout_alignParentStart="true"-->
<!--    android:layout_marginBottom="20dp"-->
<!--    android:layout_marginLeft="15sp"-->
<!--    android:layout_marginRight="15dp"-->



</RelativeLayout>