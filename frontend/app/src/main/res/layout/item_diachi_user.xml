<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:backgroundTintMode="add"
    android:clipToOutline="true"
    android:backgroundTint="@null"
    android:padding="2dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_edittext_border"
        android:padding="15dp"
        android:layout_marginBottom="8dp"
        android:backgroundTintMode="add"
        android:clipToOutline="true"
        android:backgroundTint="@null"
        android:layout_marginTop="5dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvNamDC"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nhà riêng"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/tvND"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25 Đường Hoa Sữa, Phường 7, Quận Phú Nhuận, TP. Hồ Chí Minh"
                android:textSize="12sp"
                android:textColor="#555"
                android:layout_marginTop="10dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvMacDinh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mặc định"
            android:textColor="@color/pinkDark"
            android:textSize="13sp"
            android:visibility="visible"/>
    </LinearLayout>

</LinearLayout>