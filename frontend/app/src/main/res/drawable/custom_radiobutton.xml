<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_checked="true">
        <layer-list>
            <!-- Viền ngoài -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/pinkDark"/>
                </shape>
            </item>
            <!-- Chấm giữa hồng đậm -->
            <item
                android:width="12dp"
                android:height="12dp"
                android:gravity="center">
                <shape android:shape="oval">
                    <solid android:color="@color/pinkDark"/>
                </shape>
            </item>
        </layer-list>
    </item>


    <!-- Khi chưa chọn -->
    <item android:state_checked="false">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/pinkDark"/>
                </shape>
            </item>
            <item
                android:width="16dp"
                android:height="16dp"
                android:gravity="center">
                <shape android:shape="oval">
                    <stroke android:width="2dp" android:color="@color/pinkDark"/>
                    <solid android:color="#FFE8E9"/>
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
