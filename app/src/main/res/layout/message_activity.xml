<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pinkLight"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/pink_back"
            android:layout_marginLeft="25dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="25dp"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_avatar"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="15dp"/>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SweetPaw"
                android:fontFamily="@font/bevietnamsemibold"
                android:textColor="@color/white"
                android:layout_marginTop="8dp"
                android:layout_marginLeft="10dp"
                android:textSize="20sp"/>
            <TextView
                android:id="@+id/activity_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trực tuyến"
                android:fontFamily="@font/bevietnamsemibold"
                android:textSize="14sp"
                android:textColor="@color/pinkDark"
                android:layout_marginTop="33dp"
                android:layout_marginLeft="10dp"/>
        </RelativeLayout>

    </LinearLayout>
    <!-- KHUNG CHAT -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:clipToPadding="false" />
    <!-- INPUT AREA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#15EEEEEE"
        android:gravity="center_vertical">

        <!-- Text input -->
        <EditText
            android:id="@+id/input_message_chat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Nhập tin nhắn ở đây"
            android:background="@drawable/bg_input_message"
            android:fontFamily="@font/bevietnammedium"
            android:textColor="@color/black"
            android:padding="12dp"
            android:textSize="14sp"
            android:inputType="text" />

        <!-- Nút gửi -->
        <ImageView
            android:id="@+id/btn_send"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/btn_send"
            android:contentDescription="Send"
            android:layout_marginStart="8dp"
            android:scaleType="centerInside" />

    </LinearLayout>

</LinearLayout>