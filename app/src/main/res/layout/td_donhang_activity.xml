<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:background="@drawable/nentieude">
        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/pink_back"
            android:layout_centerVertical="true"
            android:layout_marginLeft="30dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Theo dõi đơn hàng"
            android:textSize="22sp"
            android:textColor="@color/pinkDark"
            android:textStyle="bold"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="5dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/frame_feedback"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/frame_feedback"
                android:backgroundTint="#30D9D9D9"
                android:padding="10dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mã đơn hàng: "
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/roboto"/>
                    <TextView
                        android:id="@+id/tvMaDon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/roboto"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Đặt lúc"
                        android:textSize="13sp"
                        android:fontFamily="@font/roboto"/>
                    <TextView
                        android:id="@+id/tvTgDat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="4:43pm 16-10-2025"
                        android:textSize="13sp"
                        android:fontFamily="@font/roboto"/>
                    <TextView
                        android:id="@+id/tvDanhGia"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="Đánh giá sản phẩm"
                        android:textSize="13sp"
                        android:fontFamily="@font/bevietnammedium"
                        android:textColor="@color/pinkDark"
                        android:visibility="invisible"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="Tên người nhận:  "
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:fontFamily="@font/bevietnambold"/>
                    <TextView
                        android:id="@+id/tvNguoiNhan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:text=""
                        android:textSize="13sp"
                        android:fontFamily="@font/bevietnammedium"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="SDT:  "
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:fontFamily="@font/bevietnambold"/>
                    <TextView
                        android:id="@+id/tvSDT"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:text=""
                        android:textSize="13sp"
                        android:fontFamily="@font/bevietnammedium"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="Địa chỉ giao hàng:"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/bevietnambold"/>
                    <TextView
                        android:id="@+id/tvDiaChi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:text=""
                        android:textSize="13sp"
                        android:fontFamily="@font/bevietnammedium"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="Hình thức thanh toán: "
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/bevietnambold"/>
                    <TextView
                        android:id="@+id/tvHTThanhToan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:text="Thanh toán khi nhận hàng"
                        android:textSize="13sp"
                        android:fontFamily="@font/bevietnammedium"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp">
                    <TextView
                        android:id="@+id/tvThanhToan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="Thanh toán ngay"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#3F51B5"
                        android:fontFamily="@font/roboto"
                        android:visibility="invisible"/>
                    <TextView
                        android:id="@+id/tvStatusPayment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:text="Trạng thái thanh toán"
                        android:textColor="@color/pinkDark"
                        android:textStyle="italic"
                        android:textSize="13sp"
                        android:fontFamily="@font/bevietnambold"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/layoutTrangThaiTT"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp"
                    android:gravity="right"
                    android:layout_marginRight="35sp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="("
                        android:textColor="#0F9D58"
                        android:textStyle="italic"
                        android:textSize="13sp"
                        android:fontFamily="@font/bevietnambold"/>
                    <TextView
                        android:id="@+id/tvTrangThaiDH"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trạng thái đơn hàng"
                        android:textColor="#0F9D58"
                        android:textStyle="italic"
                        android:textSize="13sp"
                        android:fontFamily="@font/bevietnambold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" )"
                        android:textColor="#0F9D58"
                        android:textStyle="italic"
                        android:textSize="13sp"
                        android:fontFamily="@font/bevietnambold"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="Ghi chú:"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/bevietnambold"/>
                    <TextView
                        android:id="@+id/tvGhiChu"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:text=""
                        android:textSize="13sp"
                        android:fontFamily="@font/bevietnammedium"/>
                </LinearLayout>


            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProduct"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp">

            </androidx.recyclerview.widget.RecyclerView>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#D9D9D9"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tổng tiền hàng: "
                        android:textStyle="italic"
                        android:textSize="13sp"
                        android:fontFamily="@font/bevietnammedium"/>
                    <TextView
                        android:id="@+id/tvTienHang"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="395,000đ"
                        android:textSize="16sp"
                        android:fontFamily="@font/bevietnambold"
                        android:gravity="right"/>

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Phí giao hàng: "
                        android:textStyle="italic"
                        android:textSize="13sp"
                        android:fontFamily="@font/bevietnammedium"/>
                    <TextView
                        android:id="@+id/tvPhiGH"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="50,000đ"
                        android:textSize="16sp"
                        android:fontFamily="@font/bevietnambold"
                        android:gravity="right"/>

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Giảm giá: "
                        android:textStyle="italic"
                        android:textSize="13sp"
                        android:fontFamily="@font/bevietnammedium"/>
                    <TextView
                        android:id="@+id/tvGiamGia"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="-10,000đ"
                        android:textSize="16sp"
                        android:fontFamily="@font/bevietnambold"
                        android:gravity="right"/>

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tổng cộng: "
                        android:textStyle="italic"
                        android:textSize="13sp"
                        android:fontFamily="@font/bevietnammedium"/>
                    <TextView
                        android:id="@+id/tvTienTT"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="435,000đ"
                        android:textSize="16sp"
                        android:fontFamily="@font/bevietnambold"
                        android:gravity="right"
                        android:textColor="@color/pinkDark"/>

                </LinearLayout>

            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#D9D9D9" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="4"
                    android:text="Trạng thái đơn hàng"
                    android:textSize="17sp"
                    android:fontFamily="@font/roboto"
                    android:textStyle="bold"/>
                <ImageView
                    android:id="@+id/tvXemTT1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:src="@drawable/doxuong"
                    android:layout_gravity="center_vertical"/>
                <ImageView
                    android:id="@+id/tvXemTT2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:src="@drawable/keolen"
                    android:layout_gravity="center_vertical"
                    android:visibility="gone"/>

            </LinearLayout>
            <LinearLayout
                android:id="@+id/layoutTrangThai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp"
                android:layout_marginBottom="20dp"
                android:visibility="gone">
<!--                Đang xử lý-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/iconDangXL"
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:background="@drawable/bg_oval_selector"
                        android:src="@drawable/chuanbi"
                        android:padding="10dp"
                        android:layout_gravity="center_vertical"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginLeft="10dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đang xử lý"
                            android:textSize="14sp"
                            android:fontFamily="@font/bevietnambold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SweetPaw đang xử lý đơn hàng của bạn"
                            android:textColor="@color/grey"
                            android:layout_marginTop="5dp"/>



                        </LinearLayout>


                    </LinearLayout>
<!--                Đang giao hàng-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp">
                    <ImageView
                        android:id="@+id/iconGH"
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:background="@drawable/bg_oval_selector"
                        android:src="@drawable/giaohang"
                        android:padding="10dp"
                        android:layout_gravity="center_vertical"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginLeft="10dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đơn hàng đang được giao đến bạn"
                            android:textSize="14sp"
                            android:fontFamily="@font/bevietnambold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SweetPaw đã gửi đơn hàng cho đơn vị vận chuyển"
                            android:textColor="@color/grey"
                            android:layout_marginTop="5dp"/>



                    </LinearLayout>


                </LinearLayout>
<!--                Giao hàng thành công-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp">
                    <ImageView
                        android:id="@+id/iconGiaoTC"
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:background="@drawable/bg_oval_selector"
                        android:src="@drawable/giaothanhcong"
                        android:padding="10dp"
                        android:layout_gravity="center_vertical"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginLeft="10dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Giao hàng thành công"
                            android:textSize="14sp"
                            android:fontFamily="@font/bevietnambold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đơn hàng đã được giao đến bạn"
                            android:textColor="@color/grey"
                            android:layout_marginTop="5dp"/>



                    </LinearLayout>


                </LinearLayout>


            </LinearLayout>



        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>