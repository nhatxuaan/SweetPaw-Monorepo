<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="10dp">

    <!-- Tên sản phẩm -->
    <TextView
        android:id="@+id/tvTensanpham"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cà phê Mocha"
        android:fontFamily="@font/bevietnambold"
        android:textSize="14sp"
        android:textColor="#000000"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="8dp"/>
    <RatingBar
        android:id="@+id/id_rating"
        style="?android:attr/ratingBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginBottom="10dp"
        android:numStars="5"
        android:stepSize="1"
        android:progressTint="#FFD700"
        android:secondaryProgressTint="#FFD700"
        android:progressBackgroundTint="#CCCCCC"
        android:isIndicator="false"
        android:translationX="19dp"
        android:scaleX="1.5"
        android:scaleY="1.5"/>

    <!-- Ô nhập đánh giá -->
    <EditText
        android:id="@+id/edtND"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:hint="Nhập nội dung đánh giá tại đây..."
        android:background="@drawable/frame_feedback"
        android:padding="10dp"
        android:gravity="top"
        android:textSize="13sp"
        android:textColor="@color/black"
        android:fontFamily="@font/bevietnamregular"
        android:inputType="textMultiLine"
        android:scrollbars="vertical"
        android:overScrollMode="always"/>

    <!-- Nút gửi -->
    <Button
        android:id="@+id/btnGui"
        android:layout_width="80dp"
        android:layout_height="40dp"
        android:text="Gửi"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/bevietnambold"
        android:textSize="14sp"
        android:backgroundTint="@color/pinkDark"
        android:layout_gravity="end"
        android:layout_marginTop="10dp"
        android:visibility="visible"/>
<!--    Nút Xóa và Cập nhật -->
    <LinearLayout
        android:id="@+id/loXoaCN"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="right"
        android:layout_marginTop="10dp"
        android:visibility="gone">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnXoa"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:text="Xoá"
            android:textColor="@color/pinkDark"
            android:textStyle="bold"
            android:textSize="14sp"
            android:insetBottom="0dp"
            app:cornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/pinkDark"
            app:backgroundTint="@color/white"
            android:layout_gravity="center"
            android:layout_marginRight="10dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCapNhat"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Cập nhật"
            android:textColor="@color/pinkDark"
            android:textStyle="bold"
            android:textSize="14sp"
            android:insetBottom="0dp"
            app:cornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/pinkDark"
            app:backgroundTint="@color/white"
            android:layout_gravity="center" />

    </LinearLayout>
<!--    Nút Hủy và Lưu -->
    <LinearLayout
        android:id="@+id/loHuyLuu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="right"
        android:layout_marginTop="10dp"
        android:visibility="gone">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHuy"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:text="Hủy"
            android:textColor="@color/pinkDark"
            android:textStyle="bold"
            android:textSize="14sp"
            android:insetBottom="0dp"
            app:cornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/pinkDark"
            app:backgroundTint="@color/white"
            android:layout_gravity="center"
            android:layout_marginRight="10dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLuu"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Lưu"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="16sp"
            android:insetBottom="0dp"
            app:cornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/pinkDark"
            app:backgroundTint="@color/pinkDark"
            android:layout_gravity="center"/>

    </LinearLayout>

</LinearLayout>
