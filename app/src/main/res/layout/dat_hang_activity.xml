<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@color/pinkDark"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true">
        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/white_back"
            android:layout_marginTop="40dp"
            android:layout_marginLeft="20dp"/>
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ĐẶT HÀNG"
            android:textColor="@color/white"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="35dp"
            android:textSize="22sp"
            android:textStyle="bold"/>
    </RelativeLayout>

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="824dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="80dp"
        android:background="@drawable/rectangle_cart" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:padding="10dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentBottom="true">
            <LinearLayout
                android:id="@+id/tt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="5dp"
                android:padding="10dp">
                <!--                Tên người nhận-->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tên người nhận"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_edittext_border"
                    android:layout_marginBottom="8dp"
                    android:layout_marginTop="8dp">
                    <EditText
                        android:id="@+id/edtTen"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="7"
                        android:hint="Tên người nhận"
                        android:text="Nhật Xuân"
                        android:textSize="14sp"
                        android:background="@android:color/transparent"
                        android:inputType="textPersonName"
                        android:layout_marginLeft="10dp"/>
                    <ImageView
                        android:id="@+id/imgEditName"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/alow_edit"/>
                </LinearLayout>
                <!--                Số điện thoại-->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Số điện thoại"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_edittext_border"
                    android:layout_marginBottom="8dp"
                    android:layout_marginTop="8dp">
                    <EditText
                        android:id="@+id/edtSDT"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="7"
                        android:hint="Số điện thoại"
                        android:text="0348965112"
                        android:textSize="14sp"
                        android:background="@android:color/transparent"
                        android:inputType="phone"
                        android:layout_marginLeft="10dp"/>
                    <ImageView
                        android:id="@+id/imgEditSDT"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/alow_edit"/>
                </LinearLayout>

                <!-- Địa chỉ giao hàng-->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Địa chỉ giao hàng"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_edittext_border"
                    android:layout_marginBottom="8dp"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:id="@+id/edtDiaChi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="7"
                        android:hint="Địa chỉ giao hàng"
                        android:text="25 Đường Hoa Sữa, Phường 7, Quận Phú..."
                        android:textSize="14sp"
                        android:background="@android:color/transparent"
                        android:inputType="text"
                        android:layout_marginLeft="10dp"/>
                    <ImageView
                        android:id="@+id/imgEditDiaChi"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/edit_diachi"/>
                </LinearLayout>
                <!-- Phương thanh toán-->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phương thức thanh toán"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_edittext_border"
                    android:layout_marginBottom="8dp"
                    android:layout_marginTop="8dp">

                    <Spinner
                        android:id="@+id/spnPhuongThuc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:spinnerMode="dropdown"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:paddingLeft="0dp"
                        android:paddingRight="0dp"
                        android:background="@android:color/transparent" />
                    <ImageView
                        android:id="@+id/imgPThuc"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/edit_pt"
                        android:layout_alignParentRight="true"/>
                </RelativeLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Danh sách các sản phẩm"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

            </LinearLayout>

            <!-- Danh sách sản phẩm -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvSelected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:layout_marginTop="0dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true"
                android:layout_below="@id/tt"/>
            <LinearLayout
                android:id="@+id/layout2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_below="@+id/rcvSelected"
                android:layout_marginLeft="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/rcvSelected"
                    android:text="Thời gian muốn nhận bánh"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📅 Chọn ngày"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginTop="10dp"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp">
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvhomNay"
                        android:layout_width="74dp"
                        android:layout_height="28dp"
                        android:layout_marginHorizontal="8dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        android:padding="5dp"
                        app:cardBackgroundColor="#FFE8E9">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hôm nay"
                            android:layout_gravity="center"
                            android:textSize="14sp"/>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvNgayKhac"
                        android:layout_width="97dp"
                        android:layout_height="28dp"
                        android:layout_marginHorizontal="8dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        android:padding="5dp"
                        app:cardBackgroundColor="#FFE8E9">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_gravity="center">
                            <TextView
                                android:id="@+id/txtNgayKhac"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ngày khác"
                                android:layout_gravity="center"
                                android:textSize="14sp" />
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@drawable/chon_ngay"
                                android:layout_marginTop="3dp"
                                android:layout_marginLeft="5dp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⏲️ Chọn khung giờ"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginTop="10dp"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp">
                    <androidx.cardview.widget.CardView
                        android:layout_width="95dp"
                        android:layout_height="28dp"
                        android:layout_marginHorizontal="8dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        android:padding="5dp"
                        app:cardBackgroundColor="#FFE8E9">

                        <TextView
                            android:id="@+id/gio1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="9:00 - 10:00"
                            android:layout_gravity="center"
                            android:textSize="14sp"/>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="95dp"
                        android:layout_height="28dp"
                        android:layout_marginHorizontal="8dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        android:padding="5dp"
                        app:cardBackgroundColor="#FFE8E9">

                        <TextView
                            android:id="@+id/gio2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10:00-11:00"
                            android:layout_gravity="center"
                            android:textSize="14sp"/>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="95dp"
                        android:layout_height="28dp"
                        android:layout_marginHorizontal="8dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        android:padding="5dp"
                        app:cardBackgroundColor="#FFE8E9">

                        <TextView
                            android:id="@+id/gio3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="11:00-12:00"
                            android:layout_gravity="center"
                            android:textSize="14sp"/>
                    </androidx.cardview.widget.CardView>


                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp">
                    <androidx.cardview.widget.CardView
                        android:layout_width="95dp"
                        android:layout_height="28dp"
                        android:layout_marginHorizontal="8dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        android:padding="5dp"
                        app:cardBackgroundColor="#FFE8E9">

                        <TextView
                            android:id="@+id/gio4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="13:00 - 14:00"
                            android:layout_gravity="center"
                            android:textSize="14sp"/>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="95dp"
                        android:layout_height="28dp"
                        android:layout_marginHorizontal="8dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        android:padding="5dp"
                        app:cardBackgroundColor="#FFE8E9">

                        <TextView
                            android:id="@+id/gio5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="14:00-15:00"
                            android:layout_gravity="center"
                            android:textSize="14sp"/>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="95dp"
                        android:layout_height="28dp"
                        android:layout_marginHorizontal="8dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        android:padding="5dp"
                        app:cardBackgroundColor="#FFE8E9">

                        <TextView
                            android:id="@+id/gio6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15:00-16:00"
                            android:layout_gravity="center"
                            android:textSize="14sp"/>
                    </androidx.cardview.widget.CardView>


                </LinearLayout>
                <!--                Ghi chú-->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ghi chú (tùy chọn)"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginTop="10dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_edittext_border"
                    android:layout_marginRight="10dp">
                    <EditText
                        android:id="@+id/editGhiChu"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="7"
                        android:hint="VD: Ghi chữ 'Happy Birthday' lên bánh"
                        android:background="@android:color/transparent"
                        android:text="(Không có)"
                        android:textSize="11sp"
                        android:inputType="textPersonName"
                        android:layout_marginLeft="10dp"/>
                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_weight="1"
                        android:background="@drawable/edit_ghichu"/>
                </LinearLayout>
                <!--Khuyến mãi-->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mã khuyến mãi (nếu có)"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginTop="10dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_edittext_border"
                    android:layout_marginRight="10dp">
                    <EditText
                        android:id="@+id/editKM"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="6"
                        android:hint="VD:THANG10VUIVE"
                        android:background="@android:color/transparent"
                        android:text=""
                        android:textSize="11sp"
                        android:inputType="textPersonName"
                        android:layout_marginLeft="10dp"/>
                    <TextView
                        android:id="@+id/tvApDung"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="2"
                        android:background="@drawable/edit_km"
                        android:text="Áp dụng"
                        android:padding="0dp"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textStyle="italic"
                        android:textColor="@color/white"/>
                </LinearLayout>
                <!--                Thong bao ap dung thanh cong-->
                <TextView
                    android:id="@+id/tvThongBaoKM"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Áp dụng mã giảm"
                    android:textSize="12sp"
                    android:textStyle="italic"
                    android:textColor="@color/pinkDark"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone"/>
                <TextView
                    android:id="@+id/tvThongBao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xử lý tính tiền"
                    android:textSize="12sp"
                    android:textStyle="italic"
                    android:textColor="#31AA52"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_edittext_border"
                    android:padding="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="10dp">
                    <!--       Tiền hàng-->
                    <LinearLayout
                        android:id="@+id/layoutTienHang"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="0dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="8"
                            android:text="Tổng tiền hàng:"
                            android:textStyle="italic"
                            android:textSize="13sp"/>
                        <TextView
                            android:id="@+id/tvTongTien"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:text="415,000đ"
                            android:fontFamily="@font/roboto"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:gravity="right"/>
                    </LinearLayout>
                    <!-- Phí giao hàng-->
                    <LinearLayout
                        android:id="@+id/layoutPhiGH"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="8"
                            android:text="Phí giao hàng:"
                            android:textStyle="italic"
                            android:textSize="13sp"/>
                        <TextView
                            android:id="@+id/tvPhiGH"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:text="0đ"
                            android:fontFamily="@font/roboto"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:gravity="right"/>
                    </LinearLayout>
                    <!--  Giảm giá-->
                    <LinearLayout
                        android:id="@+id/layoutGiam"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="8"
                            android:text="Giảm giá:"
                            android:textStyle="italic"
                            android:textSize="13sp"/>
                        <TextView
                            android:id="@+id/tvGiam"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:text="0đ"
                            android:fontFamily="@font/roboto"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:gravity="right"/>
                    </LinearLayout>
                    <!--   Tổng cộng-->
                    <LinearLayout
                        android:id="@+id/layoutTong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="8"
                            android:text="Tổng cộng:"
                            android:textStyle="italic"
                            android:textSize="13sp"/>
                        <TextView
                            android:id="@+id/tvTong"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:text="0đ"
                            android:fontFamily="@font/roboto"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:gravity="right"
                            android:textColor="@color/pinkDark"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>


            <Button
                android:id="@+id/btnDatHang"
                android:layout_width="107dp"
                android:layout_height="39dp"
                android:text="Đặt hàng"
                android:backgroundTint="@color/pinkDark"
                android:layout_below="@id/layout2"
                android:layout_alignParentRight="true"
                android:layout_marginRight="10dp"
                android:layout_marginTop="10dp"/>

            <LinearLayout
                android:layout_width="84dp"
                android:layout_height="40dp"
                android:orientation="vertical"
                android:layout_alignParentBottom="true"
                android:layout_below="@id/layout2"
                android:layout_toLeftOf="@id/btnDatHang">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tổng cộng:"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvTienTT"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="0đ"
                    android:textSize="13sp"
                    android:textColor="@color/pinkDark"
                    android:textStyle="bold"/>

            </LinearLayout>

        </RelativeLayout>

    </androidx.core.widget.NestedScrollView>


</RelativeLayout>